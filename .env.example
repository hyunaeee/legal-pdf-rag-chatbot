EPA_ENVIRONMENT=local
EPA_LOG_LEVEL=INFO
EPA_MAX_UPLOAD_MB=10
EPA_RETRIEVAL_K=5
EPA_REQUIRE_TENANT_HEADER=true

EPA_RETRIEVAL_BACKEND=memory
EPA_VECTOR_STORE_PATH=data/chroma
EPA_EMBEDDING_BACKEND=hash
EPA_VERTEX_EMBEDDING_MODEL=gemini-embedding-001

EPA_MODEL_BACKEND=local
EPA_MODEL_TEMPERATURE=0.1
EPA_MAX_OUTPUT_TOKENS=1024
EPA_GOOGLE_CLOUD_PROJECT=
EPA_GOOGLE_CLOUD_LOCATION=asia-northeast3
EPA_VERTEX_MODEL=gemini-2.5-flash

EPA_STRUCTURED_DATA_PATH=:memory:

EPA_OTEL_ENABLED=false
EPA_OTEL_SERVICE_NAME=enterprise-policy-agent
EPA_OTEL_EXPORTER_OTLP_ENDPOINT=

# Trusted runtime bindings for the standalone ADK and MCP examples.
EPA_ADK_MODEL=gemini-2.5-flash
EPA_ADK_TENANT_ID=demo
EPA_POLICY_DIRECTORY=data/policies
EPA_MCP_TENANT_ID=demo
